# ── GitHub OAuth (required for login) ──────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: https://your-host/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Only needed when the app cannot infer its own public URL
# (unusual proxy setups). Must match the OAuth App callback exactly.
GITHUB_CALLBACK_URL=

# Who may sign in. Comma or whitespace separated, case-insensitive.
# Entries with an "@" are matched against the account's *verified* GitHub emails,
# everything else is matched against the GitHub login (username).
GITHUB_ALLOWED_USERS=octocat,someone-else
GITHUB_ALLOWED_EMAILS=you@example.com

# Alternatively (or additionally) admit anyone in a GitHub org, optionally
# narrowed to one team. Requires the read:org scope, which is requested
# automatically when GITHUB_ALLOWED_ORG is set.
GITHUB_ALLOWED_ORG=
GITHUB_ALLOWED_TEAM=

# Admins see and control every desktop and may delete images.
# Leave empty to make every permitted user an admin (single-operator setup).
GITHUB_ADMIN_USERS=

# Sessions are signed cookies. Set a fixed secret or every restart signs
# everyone out:  openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Needed only in hostname mode, so the session reaches the desktop hostnames.
SESSION_COOKIE_DOMAIN=
# Set when TLS terminates upstream and X-Forwarded-Proto is not passed through.
FORCE_SECURE_COOKIES=false

# ── Optional reverse-proxy auth (Cloudflare Access etc.) ───
# Ignored unless REVERSE_PROXY_REQUIRED_VALUE or REVERSE_PROXY_SHARED_SECRET is
# set: an unauthenticated header is trivially forged by anyone who can reach
# this port directly.
ENABLE_REVERSE_PROXY_AUTH=false
REVERSE_PROXY_USER_HEADER=x-forwarded-user
REVERSE_PROXY_REQUIRED_VALUE=
REVERSE_PROXY_SHARED_SECRET=
REVERSE_PROXY_SECRET_HEADER=x-kasm-proxy-secret

# ── Desktop container policy ──────────────────────────────
# Bind mounts are a direct path to host root, so they are refused by default.
ALLOW_CUSTOM_BINDS=false
ALLOWED_BIND_PREFIXES=
ALLOWED_NETWORK_MODES=bridge,none

# Per-desktop resource ceilings (blank = unlimited).
# Kasm images need a large /dev/shm or the bundled browser crashes.
DEFAULT_CPU_LIMIT=
DEFAULT_MEMORY_LIMIT=
DEFAULT_SHM_SIZE=2g
DEFAULT_PIDS_LIMIT=

# Stop desktops with no traffic for this many minutes (0 = never).
IDLE_TIMEOUT_MINUTES=0

DOCKER_TIMEOUT_MS=60000
DOCKER_PULL_TIMEOUT_MS=1200000

# ── Serving desktops on their own hostname (recommended) ───
# When set, each desktop answers on its own hostname and nothing about the
# response has to be rewritten. Point a wildcard DNS record and your proxy here.
#   DESKTOP_HOSTNAME_TEMPLATE=desktop-{port}.example.com
#   SESSION_COOKIE_DOMAIN=.example.com
DESKTOP_HOSTNAME_TEMPLATE=

# ── Desktop / proxy behaviour ──────────────────────────────
PASSWORD_ENV_KEY=VNC_PW
DEFAULT_INTERNAL_PORT=6901/tcp
DEFAULT_NETWORK_MODE=bridge
DEFAULT_PROFILE_MOUNT_PATH=/home/kasm-user
INSTANCE_NAME_PREFIX=kasm-desktop-
PROFILE_VOLUME_PREFIX=kasm-profile-
MANAGED_LABEL=com.egli.kasm-manager.managed
PROXY_TEXT_REWRITE=true
LAUNCH_AUTOCONNECT=true
LAUNCH_RESIZE=remote
LAUNCH_VIEW_ONLY=false
# Set false to keep the desktop password out of the launch URL; users then read
# it from the manager and type it into the noVNC prompt.
LAUNCH_INCLUDE_PASSWORD=true
LAUNCH_TOKEN_TTL_SECONDS=120
